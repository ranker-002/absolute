# ULTIMATE — Living Intelligence Entity
# Copy this file to .env and fill in your values

# OpenRouter API Key (default provider)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Model override (default: deepseek/deepseek-v4-flash:free)
# Browse models: https://openrouter.ai/models
# ULTIMATE_MODEL=deepseek/deepseek-v4-flash:free

# Alternative: Anthropic direct (if not using OpenRouter)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_API_KEY=sk-ant-...

# Force plain console mode (no TUI)
# ULTIMATE_PLAIN=1
